generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  reference   String   @unique
  description String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  brand       String
  category    String
  image       String?
  images      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Motocarro {
  id              Int      @id @default(autoincrement())
  brand           String
  model           String
  slug            String   @unique
  description     String?
  price           Decimal? @db.Decimal(12, 2)
  stock           Int      @default(0)
  engineType      String?
  refrigeration   String?
  displacement    Int?
  horsepower      Decimal?
  maxTorque       Decimal?
  transmission    String?
  starter         String?
  loadCapacity    Int?
  fuelTank        Decimal?
  frontSuspension String?
  rearSuspension  String?
  frontBrake      String?
  rearBrake       String?
  bodyDimensions  String?
  tires           String?
  equipment       String?
  image           String?
  images          String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Moto {
  id                Int         @id @default(autoincrement())
  brand             String      @default("Vento")
  model             String
  slug              String      @unique
  description       String?

  // Información comercial
  price             Decimal?    @db.Decimal(12, 2)
  stock             Int         @default(0)
  warrantyYears     Int?
  colors            String[]    @default([])

  // Motor y rendimiento
  engineType        String?
  displacement      Decimal?    @db.Decimal(8, 2)
  horsepower        Decimal?    @db.Decimal(8, 2)
  horsepowerRpm     Int?
  maxTorque         Decimal?    @db.Decimal(8, 2)
  torqueRpm         Int?
  compressionRatio  String?
  fuelSupply        String?
  ignition          String?
  transmission      String?
  fuelCapacity      Decimal?    @db.Decimal(8, 2)

  // Dimensiones y peso
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  seatHeightMm      Int?
  groundClearanceMm Int?
  weightKg          Decimal?    @db.Decimal(8, 2)

  // Parte ciclo
  frontSuspension   String?
  rearSuspension    String?
  frontBrake        String?
  rearBrake         String?
  frontWheel        String?
  rearWheel         String?

  // Equipamiento y certificaciones
  equipment         String?
  certifications    String?

  // Imagen principal y galería
  image             String?
  images            MotoImage[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model MotoImage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  position  Int      @default(0)

  motoId    Int
  moto      Moto     @relation(fields: [motoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([motoId, position])
}