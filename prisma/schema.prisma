generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  reference   String   @unique
  description String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  brand       String
  category    String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Motocarro {
  id              Int      @id @default(autoincrement())
  brand           String
  model           String
  slug            String   @unique
  description     String?

  price           Decimal? @db.Decimal(12, 2)
  stock           Int      @default(0)

  engineType      String?
  displacement    Int?
  horsepower      Decimal?
  maxTorque       Decimal?
  transmission    String?
  starter         String?
  loadCapacity    Int?
  fuelTank        Decimal?
  frontSuspension String?
  rearSuspension  String?
  frontBrake      String?
  rearBrake       String?
  bodyDimensions  String?
  tires            String?
  equipment       String?

  image           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}