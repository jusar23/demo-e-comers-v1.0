generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  reference   String         @unique
  description String
  price       Decimal        @db.Decimal(10, 2)
  stock       Int            @default(0)
  brand       String
  category    String
  image       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProductImage[]
}

model Motocarro {
  id              Int              @id @default(autoincrement())
  brand           String
  model           String
  slug            String           @unique
  description     String?
  price           Decimal?         @db.Decimal(12, 2)
  stock           Int              @default(0)
  engineType      String?
  displacement    Int?
  horsepower      Decimal?
  maxTorque       Decimal?
  transmission    String?
  starter         String?
  loadCapacity    Int?
  fuelTank        Decimal?
  frontSuspension String?
  rearSuspension  String?
  frontBrake      String?
  rearBrake       String?
  bodyDimensions  String?
  tires           String?
  equipment       String?
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  refrigeration   String?
  images          MotocarroImage[]
}

model Moto {
  id                Int         @id @default(autoincrement())
  brand             String      @default("Vento")
  model             String
  slug              String      @unique
  description       String?
  price             Decimal?    @db.Decimal(12, 2)
  stock             Int         @default(0)
  warrantyYears     Int?
  colors            String[]    @default([])
  engineType        String?
  displacement      Decimal?    @db.Decimal(8, 2)
  horsepower        Decimal?    @db.Decimal(8, 2)
  horsepowerRpm     Int?
  maxTorque         Decimal?    @db.Decimal(8, 2)
  torqueRpm         Int?
  compressionRatio  String?
  fuelSupply        String?
  ignition          String?
  transmission      String?
  fuelCapacity      Decimal?    @db.Decimal(8, 2)
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  seatHeightMm      Int?
  groundClearanceMm Int?
  weightKg          Decimal?    @db.Decimal(8, 2)
  frontSuspension   String?
  rearSuspension    String?
  frontBrake        String?
  rearBrake         String?
  frontWheel        String?
  rearWheel         String?
  equipment         String?
  certifications    String?
  image             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  images            MotoImage[]
}

model MotoImage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  position  Int      @default(0)
  motoId    Int
  createdAt DateTime @default(now())
  moto      Moto     @relation(fields: [motoId], references: [id], onDelete: Cascade)

  @@index([motoId, position])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  position  Int      @default(0)
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model MotocarroImage {
  id          Int       @id @default(autoincrement())
  url         String
  alt         String?
  position    Int       @default(0)
  motocarroId Int
  createdAt   DateTime  @default(now())
  motocarro   Motocarro @relation(fields: [motocarroId], references: [id], onDelete: Cascade)

  @@index([motocarroId, position])
}

model CompanyBranch {
  id        Int      @id @default(autoincrement())
  name      String
  city      String
  address   String
  phone     String?
  whatsapp  String?
  email     String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([active, position])
}

model GalleryImage {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  url         String
  alt         String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, position])
}
